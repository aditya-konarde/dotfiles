# =============================================================================
# Security-Focused .gitignore for Dotfiles Repository
# =============================================================================

# =============================================================================
# Secrets & Credentials (CRITICAL - never commit these)
# =============================================================================

# Environment files
.env
.env.*
.env.local

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_dsa*
id_ecdsa*
*.ppk
known_hosts

# GPG keys
*.gpg
*.asc
secring.*
trustdb.gpg

# API keys and tokens
*.token
api_key*
auth.json
oauth.json
credentials.json
credentials
credentials.toml
credentials.yaml
credentials.yml
.git-credentials
.netrc
.pypirc
secrets.yaml
secrets.yml
secrets.json

# Cloud provider credentials
.aws/credentials
.azure/
.gcloud/
.config/gcloud/
gcloud-service-key.json

# =============================================================================
# Private Keys & Certificates
# =============================================================================
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# =============================================================================
# Shell History (may contain sensitive commands)
# =============================================================================
.bash_history
.zsh_history
.history
.lesshst
.wget-hsts

# =============================================================================
# Application Secrets
# =============================================================================

# Docker
.docker/config.json

# npm/yarn
.npmrc
.yarnrc

# Kubernetes
.kube/config

# Terraform
*.tfstate
*.tfstate.*
*.tfvars

# =============================================================================
# Logs (may contain sensitive data)
# =============================================================================
*.log
logs/
log/

# =============================================================================
# OS-Specific Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =============================================================================
# Editor/IDE
# =============================================================================
*.swp
*.swo
.idea/
.vscode/settings.json
.vscode/launch.json

# =============================================================================
# Temporary Files
# =============================================================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# =============================================================================
# Local Configuration Overrides
# =============================================================================
*.local
*.local.*
config.local.*

# =============================================================================
# Application Credential Files (never commit)
# =============================================================================

# GitHub CLI tokens
.config/gh/hosts.yml

# Fish shell variables (may contain secrets via universal vars)
.config/fish/fish_variables

# Identity, account state, and desktop/runtime data are private.
.gitconfig
.config/git/
.ssh/
.gnupg/
.aws/
.cache/
.local/state/
.config/rclone/
.config/goa-1.0/
.config/pulse/
.config/noctalia/state*
.config/noctalia/plugins.json
.config/noctalia/plugins.toml
.config/BraveSoftware/
.config/chromium/
.config/mozilla/
.config/google-chrome*/
.local/share/keyrings/

# Backups and captures from desktop troubleshooting.
*.bak-*
*.before-*
*.before.*
*.old
.dotfiles_backup_*/
diagnostics/
*.jsonl
__pycache__/
*.pyc

# Public helpers/plugins only; the rest of .local stays private.
!/.local/
/.local/**
!/.local/bin/
!/.local/share/
!/.local/share/applications/
!/.local/share/noctalia/
!/.local/share/noctalia/plugins/
!/.local/share/noctalia/plugins/audio-output-cycle/
!/.local/share/noctalia/plugins/scratch-workspace-indicator/
!/.local/share/noctalia/plugins/scratch-workspace-indicator/translations/
!/.local/bin/cycle-audio-output
!/.local/bin/handy
!/.local/bin/hypr-lock-display-recover
!/.local/share/applications/chatgpt.desktop
!/.local/share/applications/kitty-open.desktop
!/.local/share/applications/kitty.desktop
!/.local/share/noctalia/plugins/audio-output-cycle/plugin.toml
!/.local/share/noctalia/plugins/audio-output-cycle/shortcut.luau
!/.local/share/noctalia/plugins/scratch-workspace-indicator/README.md
!/.local/share/noctalia/plugins/scratch-workspace-indicator/plugin.toml
!/.local/share/noctalia/plugins/scratch-workspace-indicator/service.luau
!/.local/share/noctalia/plugins/scratch-workspace-indicator/translations/en.json
!/.local/share/noctalia/plugins/scratch-workspace-indicator/widget.luau
